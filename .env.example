# Copia este archivo como .env y llena tus datos de https://dev.twitch.tv/console/apps
# Si .env no existe o está vacío, VOTE! arranca en modo demo (login simulado).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
PORT=3000
# Cambia esto cuando lo subas a internet (ej. https://vote.tudominio.com)
BASE_URL=http://localhost:3000
